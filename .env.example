# ==============================================================================
# VieNeu-TTS Gateway Environment Configuration (Template)
# ==============================================================================

HOST=0.0.0.0
PORT=8000
APP_ENV=development
DEBUG=True
PUBLIC_API_BASE_URL=http://localhost:8000
WORKER_TOKEN=your_secure_worker_token_here

KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key
KAGGLE_KERNEL_REF=your_kaggle_username/vieneu-worker
KAGGLE_KERNEL_SLUG=vieneu-worker
KAGGLE_KERNEL_TITLE=VieNeu Dual T4 Worker
KAGGLE_ACCELERATOR=nvidiaTeslaT4
KAGGLE_TIMEOUT_SECONDS=36000
KAGGLE_WORKER_DIR=./kaggle_worker

DATABASE_URL=sqlite:///./storage/vieneu_gateway.db
AUDIO_DIR=./storage/audio
SAMPLES_DIR=./storage/samples

FALLBACK_TO_LOCAL_CPU=True
VIENEU_BACKEND=auto
